{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nbti:schema:agent-response:1",
  "title": "NBTI Agent Answer Response v1",
  "oneOf": [
    { "$ref": "#/$defs/okResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "seriesRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contentDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "optionId"],
      "properties": {
        "questionId": { "$ref": "#/$defs/stableId" },
        "optionId": { "$ref": "#/$defs/stableId" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
        "selectionConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 300 },
        "code": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "issues"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_JSON",
            "SCHEMA_VALIDATION_FAILED",
            "UNSUPPORTED_PROTOCOL_VERSION",
            "SERIES_NOT_FOUND",
            "SERIES_VERSION_MISMATCH",
            "SERIES_DIGEST_MISMATCH",
            "QUESTION_SET_MISMATCH",
            "UNKNOWN_QUESTION_ID",
            "UNKNOWN_OPTION_ID",
            "DUPLICATE_ANSWER",
            "MISSING_ANSWER",
            "OUTPUT_POLICY_VIOLATION",
            "PRIVACY_POLICY_VIOLATION",
            "INVALID_AGENT_OUTPUT",
            "AGENT_REFUSED",
            "AGENT_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" },
        "issues": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/issue" }
        }
      }
    },
    "okResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "kind",
        "requestId",
        "status",
        "seriesRef",
        "answers"
      ],
      "properties": {
        "$schema": { "type": "string", "minLength": 1 },
        "protocolVersion": { "const": "1.0.0" },
        "kind": { "const": "nbti.agent-answer.response" },
        "requestId": {
          "type": "string",
          "pattern": "^req-[A-Za-z0-9_-]{4,120}$"
        },
        "status": { "const": "ok" },
        "seriesRef": { "$ref": "#/$defs/seriesRef" },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/answer" }
        },
        "agent": { "$ref": "#/$defs/agent" }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "kind",
        "requestId",
        "status",
        "seriesRef",
        "error"
      ],
      "properties": {
        "$schema": { "type": "string", "minLength": 1 },
        "protocolVersion": { "const": "1.0.0" },
        "kind": { "const": "nbti.agent-answer.response" },
        "requestId": {
          "type": "string",
          "pattern": "^req-[A-Za-z0-9_-]{4,120}$"
        },
        "status": { "const": "error" },
        "seriesRef": { "$ref": "#/$defs/seriesRef" },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  }
}
