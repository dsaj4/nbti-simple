{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nbti:schema:questionnaire:1",
  "title": "NBTI Questionnaire Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "contentDigest",
    "locale",
    "title",
    "questionCount",
    "safety",
    "dimensions",
    "questions",
    "resultTypes"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "nbti.questionnaire" },
    "id": { "$ref": "#/$defs/stableId" },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "questionCount": { "const": 12 },
    "safety": { "$ref": "#/$defs/safety" },
    "dimensions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/organizationDimension" },
        { "$ref": "#/$defs/calibrationDimension" },
        { "$ref": "#/$defs/momentumDimension" },
        { "$ref": "#/$defs/scopeDimension" }
      ],
      "items": false
    },
    "questions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/question" }
    },
    "resultTypes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/resultType" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notDiagnosis",
        "notPersonalityAssessment",
        "notAbilityRating",
        "statement"
      ],
      "properties": {
        "notDiagnosis": { "const": true },
        "notPersonalityAssessment": { "const": true },
        "notAbilityRating": { "const": true },
        "statement": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "left", "right", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "left": { "$ref": "#/$defs/endpoint" },
        "right": { "$ref": "#/$defs/endpoint" },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "organizationDimension": {
      "allOf": [
        { "$ref": "#/$defs/dimension" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "organization" },
            "left": { "type": "object", "properties": { "id": { "const": "decompose" } } },
            "right": { "type": "object", "properties": { "id": { "const": "associate" } } }
          }
        }
      ]
    },
    "calibrationDimension": {
      "allOf": [
        { "$ref": "#/$defs/dimension" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "calibration" },
            "left": { "type": "object", "properties": { "id": { "const": "evidence" } } },
            "right": { "type": "object", "properties": { "id": { "const": "context" } } }
          }
        }
      ]
    },
    "momentumDimension": {
      "allOf": [
        { "$ref": "#/$defs/dimension" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "momentum" },
            "left": { "type": "object", "properties": { "id": { "const": "anchor" } } },
            "right": { "type": "object", "properties": { "id": { "const": "probe" } } }
          }
        }
      ]
    },
    "scopeDimension": {
      "allOf": [
        { "$ref": "#/$defs/dimension" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "scope" },
            "left": { "type": "object", "properties": { "id": { "const": "global" } } },
            "right": { "type": "object", "properties": { "id": { "const": "proximate" } } }
          }
        }
      ]
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "calibration", "momentum", "scope"],
      "properties": {
        "organization": { "enum": [-2, -1, 0, 1, 2] },
        "calibration": { "enum": [-2, -1, 0, 1, 2] },
        "momentum": { "enum": [-2, -1, 0, 1, 2] },
        "scope": { "enum": [-2, -1, 0, 1, 2] }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "organization": { "enum": [-2, 2] },
            "calibration": { "const": 0 },
            "momentum": { "const": 0 },
            "scope": { "const": 0 }
          }
        },
        {
          "type": "object",
          "properties": {
            "organization": { "const": 0 },
            "calibration": { "enum": [-2, 2] },
            "momentum": { "const": 0 },
            "scope": { "const": 0 }
          }
        },
        {
          "type": "object",
          "properties": {
            "organization": { "const": 0 },
            "calibration": { "const": 0 },
            "momentum": { "enum": [-2, 2] },
            "scope": { "const": 0 }
          }
        },
        {
          "type": "object",
          "properties": {
            "organization": { "const": 0 },
            "calibration": { "const": 0 },
            "momentum": { "const": 0 },
            "scope": { "enum": [-2, 2] }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "action", "weights"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q(?:0[1-9]|1[0-2])-[0-3]$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "action": { "type": "string", "minLength": 1, "maxLength": 240 },
        "weights": { "$ref": "#/$defs/weights" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "tag", "title", "prompt", "options"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q(?:0[1-9]|1[0-2])$"
        },
        "order": { "type": "integer", "minimum": 1, "maximum": 12 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?![\\s\\S]* · )[\\s\\S]+$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "resultType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "enum": [
            "deconstructor",
            "connector",
            "calibrator",
            "context-reader",
            "anchor",
            "explorer",
            "overlooker",
            "present",
            "multi-path"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "shortLabel": { "type": "string", "minLength": 1, "maxLength": 20 }
      },
      "oneOf": [
        { "type": "object", "properties": { "id": { "const": "deconstructor" }, "label": { "const": "拆题者" } } },
        { "type": "object", "properties": { "id": { "const": "connector" }, "label": { "const": "连线者" } } },
        { "type": "object", "properties": { "id": { "const": "calibrator" }, "label": { "const": "校准者" } } },
        { "type": "object", "properties": { "id": { "const": "context-reader" }, "label": { "const": "读场者" } } },
        { "type": "object", "properties": { "id": { "const": "anchor" }, "label": { "const": "定锚者" } } },
        { "type": "object", "properties": { "id": { "const": "explorer" }, "label": { "const": "探路者" } } },
        { "type": "object", "properties": { "id": { "const": "overlooker" }, "label": { "const": "望塔者" } } },
        { "type": "object", "properties": { "id": { "const": "present" }, "label": { "const": "在场者" } } },
        { "type": "object", "properties": { "id": { "const": "multi-path" }, "label": { "const": "多路者" } } }
      ]
    }
  }
}
